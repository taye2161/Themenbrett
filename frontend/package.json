{
  "name": "we2.blatt11",
  "private": true,
  "version": "1.0.0",
  "description": "Web Engineering 2, Blatt 11",
  "type": "module",
  "scripts": {
    "abgabe": "ziplocalgit zip -f abgabe_Blatt_11.zip --addCopilotHistory --remotePath /workspaces",
    "ailog": "copilothistory export -o ailog.md --remotePath /workspaces",
    "build": "tsc -b && vite build",
    "clean": "rimraf dist coverage junit.xml abgabe*.zip all.log",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "serve -s --ssl-cert cert/public.crt --ssl-key cert/private.key -p 3000 --no-port-switching dist",
    "test": "vitest run"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "react": "19.2.6",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.6",
    "react-error-boundary": "6.1.1",
    "react-router": "7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "copilothistory": "3.0.4",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "ziplocalgit": "2.0.2"
  }
}
