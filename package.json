  "description": "Web Engineering 2, Blatt 06",
  "scripts": {
    "test": "jest --runInBand",
    "build": "tsc",
    "abgabe": "ziplocalgit zip -f abgabe_Blatt_06.zip --addCopilotHistory --remotePath /workspaces",
