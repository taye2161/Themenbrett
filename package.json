    "@types/node": "25.6.0",
    "@types/supertest": "7.2.0",
    "@types/validator": "13.15.10",
    "copilothistory": "^3.0.4",
    "jest": "30.3.0",
    "jest-extended": "7.0.0",
    "jest-junit": "17.0.0",
    "mongodb-memory-server": "11.0.1",
    "nodemon": "3.1.14",
    "restmatcher": "1.1.16",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
