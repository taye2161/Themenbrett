{
  "name": "ziplocalgit",
  "version": "2.0.2",
  "description": "Command line tool to zip the local git repository",
  "author": "Jens von Pilgrim <jens.vonpilgrim@bht-berlin.de>",
  "license": "EPL-2.0",
  "homepage": "https://gitlab.bht-berlin.de/nodepackages/ziplocalgit",
  "repository": {
    "type": "git",
    "url": "https://gitlab.bht-berlin.de/nodepackages/ziplocalgit.git"
  },
  "keywords": [
    "zip",
    "git",
    "student",
    "moodle",
    "cli"
  ],
  "bin": {
    "ziplocalgit": "./bin/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/cli.js",
    "dist/"
  ],
  "scripts": {
    "build": "tsc && copyfiles --up 1 -e ./src/**/*.ts ./src/**/*.* dist",
    "clean": "rimraf dist",
    "watch.build": "tsc --watch",
    "test": "JEST_JUNIT_SUITE_NAME=\"{filename}\" jest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cmdfiles": "^1.2.1",
    "commander": "^14.0.3",
    "copilothistory": "^3.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "copyfiles": "^2.4.1",
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
