{
  "name": "cmdfiles",
  "version": "1.2.1",
  "author": "Jens von Pilgrim <jens.vonpilgrim@bht-berlin.de>",
  "license": "EPL-2.0",
  "description": "Allows for saving and loading options of Commander to and from setting files",
  "homepage": "https://gitlab.com/jevopi/cmdfiles",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/jevopi/cmdfiles.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && copyfiles --up 1 -e ./src/**/*.ts ./src/**/*.* dist",
    "clean": "rimraf dist coverage.xml",
    "test": "JEST_JUNIT_SUITE_NAME=\"{filename}\" jest",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "copyfiles": "^2.4.1",
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
