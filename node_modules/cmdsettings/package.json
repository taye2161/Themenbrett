{
  "name": "cmdsettings",
  "version": "1.1.0",
  "author": "Jens von Pilgrim <jens.vonpilgrim@bht-berlin.de>",
  "license": "EPL-2.0",
  "description": "Allows for saving and loading options of Commander to and from setting files",
  "homepage": "https://gitlab.com/jevopi/cmdsettings",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/jevopi/cmdsettings.git"
  },
  "engines": {
    "node": ">=16"
  },
  "main": "dist/settings.js",
  "scripts": {
    "build": "tsc && copyfiles --up 1 -e ./src/**/*.ts ./src/**/*.* dist",
    "clean": "rimraf dist coverage.xml",
    "test": "JEST_JUNIT_SUITE_NAME=\"{filename}\" jest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "comment-json": "^4.4.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "copyfiles": "^2.4.1",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
